          <ST><![CDATA[Position := _Position;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{f7345217-dd0d-4fbc-9b07-e40defd1816a}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_Position := Position;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="Reset" Id="{56527dd7-9518-4373-ae28-3a279c5501c0}" FolderPath="Public Methods\">
      <Declaration><![CDATA[METHOD PUBLIC Reset : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Busy THEN
    RETURN;
ELSIF NOT _Error THEN
    Reset := TRUE;
    RETURN;
END_IF

_Busy          := TRUE;
nSequenceState := 0;
eState         := E_AxisState.eAxisState_Resetting;
Reset          := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Resetting" Id="{d2df2fe6-83df-43df-b09d-81efaee8bd0d}" FolderPath="Private Methods\Sequences\">
      <Declaration><![CDATA[METHOD PROTECTED Resetting : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nSequenceState OF
    0:
        fbMCReset(Axis := stAxis, Execute := TRUE);

        IF NOT fbMCReset.Busy THEN
            IF fbMCReset.Error THEN
                _ErrorID := fbMCReset.ErrorID;
                eState   := E_AxisState.eAxisState_Error;
            ELSIF fbMCReset.Done THEN
                nSequenceState := nSequenceState + 10;
            END_IF

            fbMCReset(Axis := stAxis, Execute := FALSE);
        END_IF

    10:
        _ErrorID  := 0;
        Resetting := TRUE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{3285e7a9-4d90-45d2-a531-84bb3a432038}" FolderPath="Public Methods\">
      <Declaration><![CDATA[METHOD Stop : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbMCHalt(Axis := stAxis, Execute := TRUE, Deceleration := _Deceleration, Jerk := _Jerk);

_Busy  := TRUE;
eState := E_AxisState.eAxisState_Stopping;
Stop   := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Velocity" Id="{1c3aff81-77c2-4e95-aa47-aa0333d653a5}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY Velocity : LREAL]]></Declaration>
      <Get Name="Get" Id="{1d7e27bd-a379-4455-89d7-98f62e759147}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Velocity := _Velocity;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{c589ae73-398a-44e8-b88b-c4cf5683a98d}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF Velocity > 0 THEN
    _Velocity := Velocity;
END_IF]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>