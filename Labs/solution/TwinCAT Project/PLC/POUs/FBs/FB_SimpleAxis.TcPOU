<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_SimpleAxis" Id="{c77f11b7-cf4e-4404-bda8-a6e373482064}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_SimpleAxis
VAR
    stAxis : AXIS_REF;
END_VAR

VAR
    fbMCReadParameterSet : MC_ReadParameterSet;
    fbMCPower            : MC_Power;
    fbMCReset            : MC_Reset;
    fbMCMoveAbsolute     : MC_MoveAbsolute;
    fbMCMoveRelative     : MC_MoveRelative;
    fbMCMoveVelocity     : MC_MoveVelocity;
    fbMCHalt             : MC_Halt;
    fbMCHome             : MC_Home;
END_VAR

VAR
    _Busy         : BOOL;
    _Error        : BOOL;
    _ErrorID      : UDINT;
    _Velocity     : LREAL;
    _Acceleration : LREAL;
    _Deceleration : LREAL;
    _Jerk         : LREAL;
    _Position     : LREAL;
    _Distance     : LREAL;
    _Override     : LREAL        := 100.0;
    _Direction    : MC_Direction := MC_Direction.MC_Positive_Direction ;
    _HomeSensor   : BOOL;
END_VAR

VAR
    bInitComplete    : BOOL;
    eState           : E_AxisState;
    nSequenceState   : UDINT := 0;
    stAxisParameters : ST_AxisParameterSet;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT Init() THEN
    //Do not pass go unless init complete
    RETURN;
END_IF

Cyclic(); //Cyclical calls to various function blocks

CASE eState OF
    E_AxisState.eAxisState_Off:
        ;
    E_AxisState.eAxisState_Disabling:
        IF fbMCPower.Error THEN
            _ErrorID := fbMCPower.ErrorID;
            eState   := E_AxisState.eAxisState_Error;
        ELSIF NOT fbMCPower.Status THEN
            eState := E_AxisState.eAxisState_Off;
        END_IF

    E_AxisState.eAxisState_Enabling:
        IF fbMCPower.Error THEN
            _ErrorID := fbMCPower.ErrorID;
            eState   := E_AxisState.eAxisState_Error;
        ELSIF fbMCPower.Status THEN
            eState := E_AxisState.eAxisState_Idle;
        END_IF

    E_AxisState.eAxisState_Idle:
        ;

    E_AxisState.eAxisState_MoveVelocity:
        IF NOT fbMCMoveVelocity.Busy THEN
            IF fbMCMoveVelocity.Error THEN
                _ErrorID := fbMCMoveVelocity.ErrorID;
                eState   := E_AxisState.eAxisState_Error;
            END_IF

            fbMCMoveVelocity(Axis := stAxis, Execute := FALSE);
        END_IF

    E_AxisState.eAxisState_MoveAbsolute:
        IF NOT fbMCMoveAbsolute.Busy THEN
            IF fbMCMoveAbsolute.Error THEN
                _ErrorID := fbMCMoveAbsolute.ErrorID;
                eState   := E_AxisState.eAxisState_Error;
            ELSIF fbMCMoveAbsolute.Done THEN
                eState := E_AxisState.eAxisState_Idle;
            END_IF

            fbMCMoveAbsolute(Axis := stAxis, Execute := FALSE);
        END_IF

    E_AxisState.eAxisState_MoveRelative:
        IF NOT fbMCMoveRelative.Busy THEN
            IF fbMCMoveRelative.Error THEN
                _ErrorID := fbMCMoveRelative.ErrorID;
                eState   := E_AxisState.eAxisState_Error;
            ELSIF fbMCMoveRelative.Done THEN
                eState := E_AxisState.eAxisState_Idle;
            END_IF

            fbMCMoveRelative(Axis := stAxis, Execute := FALSE);
        END_IF

    E_AxisState.eAxisState_Stopping:
        IF NOT fbMCHalt.Busy THEN
            IF fbMCHalt.Error THEN
                _ErrorID := fbMCHalt.ErrorID;
                eState   := E_AxisState.eAxisState_Error;
            ELSIF fbMCHalt.Done THEN
                eState := E_AxisState.eAxisState_Idle;
            END_IF

            fbMCHalt(Axis := stAxis, Execute := FALSE);
        END_IF

    E_AxisState.eAxisState_Homing:
        //Homing can have its own sequence
        IF Homing() THEN
            eState := E_AxisState.eAxisState_Idle;
        END_IF

    E_AxisState.eAxisState_Error:
        ;

    E_AxisState.eAxisState_Resetting:
        //Resetting can have its own sequence
        IF Resetting() THEN
            IF stAxis.Status.Disabled THEN
                eState := E_AxisState.eAxisState_Off;
            ELSE
                eState := E_AxisState.eAxisState_Idle;
            END_IF
        END_IF
END_CASE

_Busy  := (eState <> E_AxisState.eAxisState_Idle) AND (eState <> E_AxisState.eAxisState_Off) AND (eState <> E_AxisState.eAxisState_Error);
_Error := (eState = E_AxisState.eAxisState_Error) OR (eState = E_AxisState.eAxisState_Resetting);]]></ST>
    </Implementation>
    <Folder Name="Private Methods" Id="{74ac1887-c1eb-4067-86b9-1580417bc0a2}">
      <Folder Name="Sequences" Id="{84634393-8aee-496a-812f-2cc9812de4ae}" />
    </Folder>
    <Folder Name="Properties" Id="{62920f93-b088-4538-85e5-8a34bfb621f1}" />
    <Folder Name="Public Methods" Id="{4446fa78-05e8-4b18-88a7-a4e1c9cbf3a2}" />
    <Property Name="Acceleration" Id="{632873bb-cb2e-49ef-9c5f-3b19f0621e22}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY Acceleration : LREAL]]></Declaration>
      <Get Name="Get" Id="{731d1844-2d3d-458f-aab2-08102d06251f}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Acceleration := _Acceleration;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{39543953-017f-47b4-a15a-306c8be3aefc}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF Acceleration >= 0 THEN
    _Acceleration := Acceleration;
END_IF]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="Busy" Id="{0eb9743c-5d39-4e18-b2c8-1eaad44156ee}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY Busy : BOOL]]></Declaration>
      <Get Name="Get" Id="{f318a154-e436-4474-a8dd-ff074403707e}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Busy := _Busy;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Cyclic" Id="{9d07ae73-2959-4909-8fda-71a596217244}" FolderPath="Private Methods\">
      <Declaration><![CDATA[METHOD PROTECTED Cyclic : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stAxis.ReadStatus();

fbMCPower(Axis := stAxis, Override := _Override);

IF fbMCMoveVelocity.CommandAborted THEN
    fbMCMoveVelocity(Axis := stAxis, Execute := FALSE);
ELSE
    fbMCMoveVelocity(Axis := stAxis);
END_IF

IF fbMCMoveAbsolute.CommandAborted THEN
    fbMCMoveAbsolute(Axis := stAxis, Execute := FALSE);
ELSE
    fbMCMoveAbsolute(Axis := stAxis);
END_IF

IF fbMCMoveRelative.CommandAborted THEN
    fbMCMoveRelative(Axis := stAxis, Execute := FALSE);
ELSE
    fbMCMoveRelative(Axis := stAxis);
END_IF

IF fbMCHalt.CommandAborted THEN
    fbMCHalt(Axis := stAxis, Execute := FALSE);
ELSE
    fbMCHalt(Axis := stAxis);
END_IF

IF fbMCHome.CommandAborted THEN
    fbMCHome(Axis := stAxis, Execute := FALSE);
ELSE
    fbMCHome(Axis := stAxis, bCalibrationCam := _HomeSensor);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Deceleration" Id="{9c91387d-7e93-4657-af9f-e29641ca96b8}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY Deceleration : LREAL]]></Declaration>
      <Get Name="Get" Id="{136a01e1-1b32-4036-9b80-0a84940e1ac6}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
